    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snaprivo nimmt dein Mikrofon nur auf, wenn du es einschaltest und eine Videoaufnahme startest. Der Ton bleibt in deinem lokalen Video."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snaprivo records your microphone only when you enable it and start a video recording. Audio stays in your local video."
