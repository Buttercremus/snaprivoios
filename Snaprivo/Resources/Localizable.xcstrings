{
  "sourceLanguage": "en",
  "strings": {
    "\n%lld × %lld Pixel · %@\nMit Stop beenden und im Videoeditor öffnen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\n%lld × %lld Pixel · %@\nMit Stop beenden und im Videoeditor öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\n%lld × %lld pixels · %@\nChoose Stop to finish and open the video editor."
          }
        }
      }
    },
    " – Kopie": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " – Kopie"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " – Copy"
          }
        }
      }
    },
    "„%@“ wird mit Original und allen Bearbeitungen dauerhaft gelöscht. Das lässt sich nicht rückgängig machen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird mit Original und allen Bearbeitungen dauerhaft gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will be permanently deleted, including the original and all edits. This cannot be undone."
          }
        }
      }
    },
    "„PNG speichern …“ beginnt in diesem Ordner. Du kannst den Zielort beim Speichern weiter ändern.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„PNG speichern …“ beginnt in diesem Ordner. Du kannst den Zielort beim Speichern weiter ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save PNG starts in this folder. You can still choose another location when saving."
          }
        }
      }
    },
    "„PNG speichern …“ exportiert den bearbeiteten Ausschnitt an einen gewählten Ort. Das Original bleibt im Projekt erhalten.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„PNG speichern …“ exportiert den bearbeiteten Ausschnitt an einen gewählten Ort. Das Original bleibt im Projekt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save PNG exports the edited crop to a location you choose. The original stays in the project."
          }
        }
      }
    },
    "%@ · %lld × %lld Pixel\nPrüfe die Übergänge in der Vorschau.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld × %lld Pixel\nPrüfe die Übergänge in der Vorschau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld × %lld pixels\nCheck the seams in the preview."
          }
        }
      }
    },
