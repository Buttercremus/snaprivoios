    },
    "macOS zeigt die Freigabe an, hat den Zugriff für diese App-Sitzung aber abgelehnt. Beende Snaprivo und öffne die App erneut. Deine Projekte werden beim Beenden gesichert.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS zeigt die Freigabe an, hat den Zugriff für diese App-Sitzung aber abgelehnt. Beende Snaprivo und öffne die App erneut. Deine Projekte werden beim Beenden gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS shows permission as granted, but has denied access for this app session. Quit Snaprivo and open it again. Your projects will be saved when you quit."
          }
        }
      }
