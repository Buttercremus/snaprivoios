    "Scrolle im gewählten Bereich nach unten, warte kurz und füge den nächsten Abschnitt hinzu. Mindestens ein Drittel Überlappung behalten. Fenster und Bereich nicht verschieben.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolle im gewählten Bereich nach unten, warte kurz und füge den nächsten Abschnitt hinzu. Mindestens ein Drittel Überlappung behalten. Fenster und Bereich nicht verschieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll down in the selected region, wait a moment, then add the next section. Keep at least one-third overlap. Do not move the window or selection."
          }
        }
      }
    },
