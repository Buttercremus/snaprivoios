          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titles, tags, and collections are always searchable. OCR stores recognized visible image text locally in a disposable search cache. Turning it off removes this cache."
          }
        }
      }
    },
