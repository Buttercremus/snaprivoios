    "Unbegrenzte Screenshots, Schnellvorschau, Anheften, grundlegende Bildwerkzeuge, Abdecken, Objektliste, lokale Bibliothek, Titelsuche, Favoriten und PNG/JPEG/Bild-PDF. Vorhandene Inhalte öffnen, exportieren, sichern, wiederherstellen und löschen bleibt immer möglich." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbegrenzte Screenshots, Schnellvorschau, Anheften, grundlegende Bildwerkzeuge, Abdecken, Objektliste, lokale Bibliothek, Titelsuche, Favoriten und PNG/JPEG/Bild-PDF. Vorhandene Inhalte öffnen, exportieren, sichern, wiederherstellen und löschen bleibt immer möglich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlimited screenshots, quick preview, pinning, basic image tools, redaction, object list, local library, title search, favorites, and PNG/JPEG/image PDF. You can always open, export, back up, restore, and delete existing content."
          }
        }
