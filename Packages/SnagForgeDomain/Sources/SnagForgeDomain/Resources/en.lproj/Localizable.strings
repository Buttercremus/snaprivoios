/* Native domain error messages. Keys stay stable across languages. */
"Das Originalbild des Projekts fehlt." = "The original image for this project is missing.";
"Das Projekt ist beschädigt oder enthält ungültige Bilddaten." = "The project is damaged or contains invalid image data.";
"Der Aufnahmebereich wurde verändert oder ist zu groß. Bitte neu beginnen." = "The capture region has changed or is too large. Please start again.";
"Der Inhalt bewegt sich noch. Warte, bis Scrollen und Animationen stillstehen, und versuche es erneut." = "The content is still moving. Wait for scrolling and animations to stop, then try again.";
"Der Übergang ist nicht eindeutig. Scrolle zurück und dann weniger weit nach unten. Mindestens ein Drittel des bisherigen Inhalts muss sichtbar bleiben." = "The join is ambiguous. Scroll back, then move down a shorter distance. At least one third of the previous content must remain visible.";
"Die Grenze von 20.000 Pixeln Höhe, 40 Millionen Pixeln oder 50 Abschnitten ist erreicht. Öffne das bisherige Ergebnis im Editor." = "The limit of 20,000 pixels in height, 40 million pixels or 50 sections has been reached. Open the current result in the editor.";
"Die Markierungen überschreiten die Projektgrenze von 32 MB. Kürze sehr lange Texte oder entferne Objekte." = "The annotations exceed the 32 MB project limit. Shorten very long text or remove objects.";
"Die gewählte Datei überschreitet die unterstützte Dateigröße. Sie wurde nicht übernommen." = "The selected file exceeds the supported file size. It was not imported.";
"Dieses Projekt benötigt eine andere Snaprivo-Version. Es wird nicht überschrieben." = "This project requires a different version of Snaprivo. It will not be overwritten.";
"Ein feststehender Kopf- oder Fußbereich stört den Übergang. Bitte neu beginnen und nur den scrollenden Inhalt auswählen." = "A fixed header or footer is interfering with the join. Start again and select only the scrolling content.";
"Ein neuerer Projektstand wurde bereits gespeichert. Sichere deine Änderungen als Kopie." = "A newer version of the project has already been saved. Save your changes as a copy.";
"Endgültiges Löschen noch nicht abgeschlossen: %@: %@" = "Permanent deletion is not complete yet: %@: %@";
"Noch kein neuer Abschnitt. Scrolle etwas nach unten und füge ihn erneut hinzu." = "No new section yet. Scroll down a little and add it again.";
